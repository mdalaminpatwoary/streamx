{
  "functions": {
    "api/*.js": {
      "includeFiles": "assets/js/data/catalog.js"
    }
  },
  "rewrites": [
    {
      "source": "/auth/microsoft",
      "destination": "/api/oauth?a=cb&p=microsoft"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/return-policy",
      "destination": "/refund-policy/",
      "permanent": true
    },
    {
      "source": "/return-policy/",
      "destination": "/refund-policy/",
      "permanent": true
    }
  ]
}