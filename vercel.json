{
  "functions": {
    "api/*.js": { "includeFiles": "assets/js/data/catalog.js" }
  },
  "rewrites": [
    { "source": "/auth/microsoft", "destination": "/api/oauth?a=cb&p=microsoft" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
