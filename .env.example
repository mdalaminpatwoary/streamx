# Copy these into Vercel: Project > Settings > Environment Variables.
# NEVER put real values in this file or in any website file.
EPS_ENV=sandbox
EPS_MERCHANT_ID=
EPS_STORE_ID=
EPS_USERNAME=
EPS_PASSWORD=
EPS_HASH_KEY=
# Optional: only if your live domain differs from the address people open
# SITE_URL=https://streamx.com.bd

# Order e-mail copy to the owner (free account at resend.com; use the same address as the account e-mail)
RESEND_API_KEY=
# ORDER_EMAIL_TO=streamx.com.bd@gmail.com

# Trending section (free key from themoviedb.org: Settings > API). Either the v3 API key or the v4 read access token works.
TMDB_API_KEY=
